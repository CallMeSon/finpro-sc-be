{
  "info": {
    "name": "JMK48 Ticket API",
    "description": "Collection pengujian CRUD REST API Pemesanan Tiket Konser JMK48.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "ticketId",
      "value": "isi_dengan_id_dari_response_POST"
    }
  ],
  "item": [
    {
      "name": "1. Create Ticket (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"namaPemesan\": \"Gerson\",\n  \"emailPemesan\": \"gerson@mail.com\",\n  \"kategoriTicket\": \"VVIP\",\n  \"jumlahTicket\": 2,\n  \"lineupGroup\": \"Lineup Ngawi (Lil nus nus, Mas Amba, Rusdi)\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/tickets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets"
          ]
        }
      }
    },
    {
      "name": "2. Read All Tickets (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tickets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets"
          ]
        }
      }
    },
    {
      "name": "3. Read Ticket by ID (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets",
            "{{ticketId}}"
          ]
        }
      }
    },
    {
      "name": "4. Update Ticket (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"statusPembayaran\": \"dana masuk boskyuh\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets",
            "{{ticketId}}"
          ]
        }
      }
    },
    {
      "name": "5. Delete Ticket (DELETE)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets",
            "{{ticketId}}"
          ]
        }
      }
    }
  ]
}
